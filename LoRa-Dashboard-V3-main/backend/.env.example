# Serial Port Configuration
# Windows: COM1, COM3, etc.
# Linux/Mac: /dev/ttyUSB0, /dev/ttyACM0
SERIAL_PORT=COM3
SERIAL_BAUD=9600

# API Server Configuration
API_PORT=5000

# MQTT Broker Configuration (Optional)
# If using a local broker like Mosquitto
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=sat

# IT Admin Approval Notification (SMTP)
# Recipient: AhmedMKAlzoubi@gmail.com
IT_ADMIN_EMAIL=AhmedMKAlzoubi@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_app_password
